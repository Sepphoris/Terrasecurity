<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="PlantBase">
        <defName>ET_Linkroot_Aptitude</defName>
        <label>Linkroot</label>
        <description>Linkroot for aptitude.</description>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <Nutrition>0</Nutrition>
        </statBases>
        <graphicData>
            <texPath>Things/Plant/PotatoPlant</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <selectable>true</selectable>
        <pathCost>14</pathCost>
        <ingestible />
        <plant>
            <immatureGraphicPath>Things/Plant/PotatoPlant_Immature</immatureGraphicPath>
            <fertilitySensitivity>0.1</fertilitySensitivity>
            <sowTags />
            <fertilityMin>0.1</fertilityMin>
            <topWindExposure>0.1</topWindExposure>
            <growDays>0.5</growDays>
            <visualSizeRange>0.5~1</visualSizeRange>
        </plant>
        <comps>
            <li Class="CompProperties_Forbiddable">
            </li>
            <li Class="Ecotech.CompProperties_CountLimit">
                <countLimit>1</countLimit>
            </li>
            <li Class="Ecotech.CompProperties_LinkRoot"> <!--Add plant def to workgiver!-->
                <gizmoLabel>root linking</gizmoLabel>
                <progressPerTick>0.1</progressPerTick>
                <maxProgress>500</maxProgress>
                <tendIcon>Effects/SFX/Particle_Ring</tendIcon>
                <linkedResearch>
                    <li>
                        <threshold>500</threshold>
                        <unlockedResearch>ET_TierOneOrganicMastery</unlockedResearch>
                    </li>
                </linkedResearch>
                <forbiddenResearch>
                    <li>Electricity</li>
                </forbiddenResearch>
            </li>
        </comps>
    </ThingDef>
    
</Defs>
