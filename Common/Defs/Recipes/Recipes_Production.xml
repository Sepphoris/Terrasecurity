<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>TS_TerraforgeSeedRecipe</defName>
    <label>shape channeling seed (terraforge) </label>
    <description>Shape a seed that will quickly grow into a Terraforge. The terraforge is crucial in utilizing and advancing Terratech.</description>
    <jobString>shaping a sap terraforge seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
      <skillRequirements>
        <Plants>4</Plants>
      </skillRequirements>
    <researchPrerequisite>TS_TerraseedEssentials</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>6400</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <TS_Seed_Terraforge>1</TS_Seed_Terraforge>
    </products>
    <displayPriority>900</displayPriority>
  </RecipeDef>

  <RecipeDef>
    <defName>TS_SapFilterSeedRecipe</defName>
    <label>shape channeling seed (sap transposer) </label>
    <description>Shape a seed that will quickly grow into a Sap Transposer. Sap Transposers take excess glowsap, and filter it into a random, more specialized sap.</description>
    <jobString>shaping a sap transposer seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
      <skillRequirements>
        <Plants>4</Plants>
      </skillRequirements>
    <researchPrerequisite>TS_GlowsapRefinement</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>3200</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <TS_Seed_SapFilter>1</TS_Seed_SapFilter>
    </products>
    <displayPriority>910</displayPriority>
  </RecipeDef>

  <RecipeDef>
    <defName>TS_SmallTerravatSeedRecipe</defName>
    <label>shape channeling seed (small terravat) </label>
    <description>Shape a seed that will quickly grow into a small Terravat. This terravat is quite compact, but can only hold one item at a time.</description>
    <jobString>shaping a terrvat seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
      <skillRequirements>
        <Plants>6</Plants>
      </skillRequirements>
    <researchPrerequisite>TS_Terravats</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>4800</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <TS_Seed_SmallTerravat>1</TS_Seed_SmallTerravat>
    </products>
    <displayPriority>920</displayPriority>
  </RecipeDef>

<!--Filter recipes-->
  <RecipeDef>
    <defName>TS_SapFilterBrightsapRecipe</defName>
    <label>filter glowsap to brightsap</label>
    <description>Produce a single jar of brightsap. Brightsap is considered a purer form of glowsap, consiting only of luminescent and growth elements while discarding everything else, and thus does not require as much glowsap.</description>
    <jobString>filtering glowsap to brightsap.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
      <skillRequirements>
        <Plants>5</Plants>
      </skillRequirements>
    <researchPrerequisite>TS_GlowsapRefinement</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>4800</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>TS_Glowsap</li>
          </thingDefs>
        </filter>
        <count>225</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>TS_Glowsap</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <TS_Brightsap>1</TS_Brightsap>
    </products>
    <displayPriority>900</displayPriority>
  </RecipeDef>

